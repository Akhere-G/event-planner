# Google Calendar sync (see src/calendar_sync). Create an OAuth client of type
# "Web application" in Google Cloud and enable the Google Calendar API.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Must be registered as an authorised redirect URI on the OAuth client.
GOOGLE_CALENDAR_REDIRECT_URI=https://your-host/api/calendar/google/callback
# Public HTTPS URL Google posts change notifications to. Calendar watch
# channels cannot target localhost, so use a tunnel in development.
GOOGLE_CALENDAR_WEBHOOK_URL=https://your-host/api/calendar/google/webhook
# Fernet key used to encrypt stored refresh tokens. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CALENDAR_TOKEN_ENCRYPTION_KEY=
